<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="dev.rancher.android.accessibility.RancherAccessibilityService"
            android:description="@string/rancher_accessibility_description"
            android:exported="false"
            android:label="Rancher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rancher_accessibility_service" />
        </service>
    </application>
</manifest>
